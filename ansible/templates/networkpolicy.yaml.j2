apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: {{ policy.name }}
  namespace: {{ policy.namespace }}
spec:
  # 네임스페이스의 모든 파드에 적용
  podSelector: {}
  policyTypes:
    - Ingress
  ingress:
    - from:
{% for ns in policy.from_namespaces | default([]) %}
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ ns }}
{% endfor %}
{% for cidr in policy.from_cidrs | default([]) %}
        - ipBlock:
            cidr: {{ cidr }}
{% endfor %}
      ports:
        - protocol: TCP
          port: 8080
